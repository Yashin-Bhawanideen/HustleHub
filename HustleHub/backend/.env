# ---- Server ----
PORT=5000
NODE_ENV=development
# Only used when running the frontend dev server (npm run dev) on a different port
CLIENT_ORIGIN=http://localhost:3000

# ---- Azure Cosmos DB for MongoDB / Azure DocumentDB ----
# Paste your connection string here (Azure Portal > your cluster > Connection strings).
# Replace <password> with your real password. If the password has special characters
# (@ : / ? # % etc.) it must be URL-encoded - see README step 2.
MONGODB_URI=mongodb+srv://dbuser1eospu:Yashinog%23123@hustlehub-dev.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
# Database name that will be created automatically on first write
DB_NAME=hustlehub

# ---- JWT ----
# Generate one in the VS code terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=066e626889f046b41505ccb1b595293519b7197906d397b4308281d9a6e32d47e1b1786938f4fe1f91b7a3c6eae5fcf9
JWT_EXPIRES_IN=1h

# ---- Password hashing ----
BCRYPT_SALT_ROUNDS=12
